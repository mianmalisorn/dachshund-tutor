# Never use this file as-is; no actual credentials belong in the repository.
APP_ENV=production
SECRET_KEY=GENERATE_RANDOM_48_PLUS_CHARACTERS
DATABASE_URL=sqlite:////data/tutor.db
UPLOAD_ROOT=/data/uploads
TUTOR_DATA_DIR=/data
ALLOWED_HOSTS=YOUR_ACTUAL_AMVERA_DOMAIN
SECURE_COOKIES=true
APP_TIMEZONE=Europe/Moscow
# Obtain exact ingress address/range from Amvera; do not use *.
TRUSTED_PROXY_IPS=127.0.0.1
INIT_NEW_DATABASE=false
TELEGRAM_ENABLED=false
PERSONAL_TELEGRAM_ENABLED=false
# First EMPTY database only: INIT_NEW_DATABASE=true and temporary bootstrap secrets.
# BOOTSTRAP_ADMIN_USERNAME=teacher
# BOOTSTRAP_ADMIN_PASSWORD=GENERATE_RANDOM_16_PLUS_CHARACTERS
